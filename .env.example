# ========================================================
# PHANTOM AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# AI Inference Provider: 'demo' | 'google-ai' | 'local'
# Default: demo (runs safely with simulated horror responses and zero setup)
AI_PROVIDER=demo

# Configured Model Name:
# - For Google AI API: 'gemma-2-9b-it' or 'gemini-3.8-flash'
# - For Local Ollama: 'gemma2:9b' or 'gemma2:2b'
# (Note: Gemma 4 was requested but is unreleased; use Gemma 2)
GEMMA_MODEL=gemma-2-9b-it

# Local Inference Endpoint (Ollama or vLLM)
LOCAL_INFERENCE_ENDPOINT=http://localhost:11434

# Google AI Studio API Key (Server-side only; required only if AI_PROVIDER=google-ai)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Port
PORT=3000

# Application Host URL (Injected by Cloud Run or local dev)
APP_URL=http://localhost:3000
